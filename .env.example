# Server-only credential. Never expose it with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# Cost-sensitive default for the booking assistant and generated copy.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna

# Optional workload-specific overrides.
OPENAI_SLOGAN_MODEL=gpt-5.6-luna
OPENAI_WEATHER_MODEL=gpt-5.6-luna

# Server-only transactional email credentials.
RESEND_API_KEY=
SMTP_FROM="La Vieja Adventures <noreply@laviejaadventures.com>"
