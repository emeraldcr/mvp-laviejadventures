# Server-only credential. Never expose it with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# Cost-sensitive default for the booking assistant and generated copy.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna

# Optional workload-specific overrides.
OPENAI_SLOGAN_MODEL=gpt-5.6-luna
OPENAI_WEATHER_MODEL=gpt-5.6-luna

# Server-only transactional email credentials.
RESEND_API_KEY=
SMTP_FROM="La Vieja Adventures <noreply@laviejaadventures.com>"

# Grok Army Command (/bots) — optional. Agents preferring "claude" fail
# their chat calls until this is set; "chatgpt" agents reuse OPENAI_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_BOTS_MODEL=claude-sonnet-4-5-20250929
OPENAI_BOTS_MODEL=

# Optional: lets agents actually commit/open PRs via the GitHub REST API.
# Without it, commit actions no-op with a clear "skipped" response.
GITHUB_TOKEN=

# Optional: a project-scoped Vercel Deploy Hook URL (Vercel dashboard →
# Project Settings → Git → Deploy Hooks). Fired only after an admin approves
# a pending "deploy" action in the approval queue.
VERCEL_DEPLOY_HOOK_URL=
