# Keep text files consistent across Windows, macOS, Linux, CI, and deployments.
* text=auto eol=lf

# Windows-native scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary images and documents.
*.avif binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary

# Binary audio and video.
*.aac binary
*.m4a binary
*.mov binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.wav binary
*.webm binary

# Binary fonts and archives.
*.eot binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.7z binary
*.gz binary
*.tar binary
*.zip binary
