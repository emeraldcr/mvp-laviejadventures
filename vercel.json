{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "master": true
    }
  },
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm ci",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude).agents' ':(exclude)*.md'",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "laviejaadventures.com"
        }
      ],
      "destination": "https://www.laviejaadventures.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|gif|png|webp|avif|ico|svg|woff2|woff))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
